<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Form View -->
        <record id="view_password_category_form" model="ir.ui.view">
            <field name="name">password.category.form</field>
            <field name="model">password.category</field>
            <field name="arch" type="xml">
                <form string="Password Category">
                    <sheet>
                        <div class="oe_title">
                            <h1>
                                <field name="name" placeholder="Category Name"/>
                            </h1>
                        </div>
                        <group>
                            <group>
                                <field name="user_id"/>
                                <field name="company_id" groups="base.group_multi_company"/>
                            </group>
                            <group>
                                <field name="password_count"/>
                            </group>
                        </group>
                        <notebook>
                            <page string="Description">
                                <field name="description"/>
                            </page>
                            <page string="Password Entries">
                                <field name="password_entry_ids">
                                    <tree>
                                        <field name="name"/>
                                        <field name="username"/>
                                        <field name="password_strength" widget="badge"/>
                                        <field name="last_modified"/>
                                    </tree>
                                </field>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- Tree View -->
        <record id="view_password_category_tree" model="ir.ui.view">
            <field name="name">password.category.tree</field>
            <field name="model">password.category</field>
            <field name="arch" type="xml">
                <tree string="Password Categories">
                    <field name="name"/>
                    <field name="password_count"/>
                    <field name="user_id"/>
                    <field name="company_id" groups="base.group_multi_company"/>
                </tree>
            </field>
        </record>

        <!-- Search View -->
        <record id="view_password_category_search" model="ir.ui.view">
            <field name="name">password.category.search</field>
            <field name="model">password.category</field>
            <field name="arch" type="xml">
                <search string="Password Categories">
                    <field name="name"/>
                    <field name="description"/>
                    <group expand="0" string="Group By">
                        <filter string="Owner" name="group_by_owner" context="{'group_by': 'user_id'}"/>
                        <filter string="Company" name="group_by_company" context="{'group_by': 'company_id'}" groups="base.group_multi_company"/>
                    </group>
                </search>
            </field>
        </record>

        <!-- Action -->
        <record id="action_password_category" model="ir.actions.act_window">
            <field name="name">Categories</field>
            <field name="res_model">password.category</field>
            <field name="view_mode">tree,form</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    No categories found
                </p>
                <p>
                    Create your first category to organize your passwords.
                </p>
            </field>
        </record>
    </data>
</odoo> 