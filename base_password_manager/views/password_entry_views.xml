<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Password Entry Form View -->
        <record id="view_password_entry_form" model="ir.ui.view">
            <field name="name">password.entry.form</field>
            <field name="model">password.entry</field>
            <field name="arch" type="xml">
                <form string="Password Entry">
                    <header>
                        <button name="action_share_password" string="Share Password" type="object" class="oe_highlight"/>
                    </header>
                    <sheet>
                        <div class="oe_title">
                            <h1>
                                <field name="name" placeholder="Title"/>
                            </h1>
                        </div>
                        <group>
                            <group>
                                <field name="username"/>
                                <field name="encrypted_password" password="True"/>
                                <field name="url"/>
                            </group>
                            <group>
                                <field name="company_id"/>
                                <field name="user_id"/>
                                <field name="last_modified"/>
                            </group>
                        </group>
                        <notebook>
                            <page string="Access Information">
                                <group>
                                    <group string="Direct Access">
                                        <field name="share_ids" readonly="1"/>
                                    </group>
                                </group>
                            </page>
                            <page string="Notes">
                                <field name="notes"/>
                            </page>
                        </notebook>
                    </sheet>

                </form>
            </field>
        </record>

        <!-- Password Entry Tree View -->
        <record id="view_password_entry_tree" model="ir.ui.view">
            <field name="name">password.entry.tree</field>
            <field name="model">password.entry</field>
            <field name="arch" type="xml">
                <tree string="Passwords">
                    <field name="name"/>
                    <field name="username"/>
                    <field name="url"/>
                    <field name="last_modified"/>
                </tree>
            </field>
        </record>

        <!-- Password Entry Search View -->
        <record id="view_password_entry_search" model="ir.ui.view">
            <field name="name">password.entry.search</field>
            <field name="model">password.entry</field>
            <field name="arch" type="xml">
                <search string="Search Passwords">
                    <field name="name"/>
                    <field name="username"/>
                    <field name="url"/>
                    <filter string="My Passwords" name="my_passwords" domain="[('user_id', '=', uid)]"/>
                </search>
            </field>
        </record>

        <!-- Password Entry Action -->
        <record id="action_password_entry" model="ir.actions.act_window">
            <field name="name">Passwords</field>
            <field name="res_model">password.entry</field>
            <field name="view_mode">tree,form</field>
            <field name="search_view_id" ref="view_password_entry_search"/>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Create your first password entry
                </p>
            </field>
        </record>

        <!-- Menu -->

    </data>
</odoo> 