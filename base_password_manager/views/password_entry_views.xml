<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Password Entry Form View -->
        <record id="view_password_entry_form" model="ir.ui.view">
            <field name="name">password.entry.form</field>
            <field name="model">password.entry</field>
            <field name="arch" type="xml">
                <form string="Password Entry">
                    <header>
                        <button name="action_share_password" string="Share" type="object"/>
                    </header>
                    <sheet>
                        <div class="oe_title">
                            <h1>
                                <field name="name" placeholder="Title"/>
                            </h1>
                        </div>
                        <group>
                            <group>
                                <field name="username"/>
                                <field name="encrypted_password" password="True"/>
                                <field name="url"/>
                                <field name="category_id"/>
                            </group>
                            <group>
                                <field name="user_id"/>
                                <field name="company_id" groups="base.group_multi_company"/>
                                <field name="last_modified"/>
                                <field name="password_strength" widget="badge" 
                                       decoration-success="password_strength == 'strong'"
                                       decoration-warning="password_strength == 'medium'"
                                       decoration-danger="password_strength == 'weak'"/>
                            </group>
                        </group>
                        <notebook>
                            <page string="Notes">
                                <field name="notes"/>
                            </page>
                        </notebook>
                    </sheet>
                    <div class="oe_chatter">
                        <field name="message_follower_ids"/>
                        <field name="activity_ids"/>
                        <field name="message_ids"/>
                    </div>
                </form>
            </field>
        </record>

        <!-- Password Entry Tree View -->
        <record id="view_password_entry_tree" model="ir.ui.view">
            <field name="name">password.entry.tree</field>
            <field name="model">password.entry</field>
            <field name="arch" type="xml">
                <tree string="Password Entries" decoration-success="password_strength == 'strong'" decoration-warning="password_strength == 'medium'" decoration-danger="password_strength == 'weak'">
                    <field name="name"/>
                    <field name="username"/>
                    <field name="category_id"/>
                    <field name="user_id"/>
                    <field name="last_modified"/>
                    <field name="password_strength" widget="badge"/>
                    <field name="company_id" groups="base.group_multi_company"/>
                </tree>
            </field>
        </record>

        <!-- Password Entry Search View -->
        <record id="view_password_entry_search" model="ir.ui.view">
            <field name="name">password.entry.search</field>
            <field name="model">password.entry</field>
            <field name="arch" type="xml">
                <search string="Password Entries">
                    <field name="name"/>
                    <field name="username"/>
                    <field name="category_id"/>
                    <separator/>
                    <filter string="Strong Passwords" name="strong" domain="[('password_strength', '=', 'strong')]"/>
                    <filter string="Medium Passwords" name="medium" domain="[('password_strength', '=', 'medium')]"/>
                    <filter string="Weak Passwords" name="weak" domain="[('password_strength', '=', 'weak')]"/>
                    <group expand="0" string="Group By">
                        <filter string="Category" name="group_by_category" context="{'group_by': 'category_id'}"/>
                        <filter string="Owner" name="group_by_owner" context="{'group_by': 'user_id'}"/>
                        <filter string="Password Strength" name="group_by_strength" context="{'group_by': 'password_strength'}"/>
                        <filter string="Company" name="group_by_company" context="{'group_by': 'company_id'}" groups="base.group_multi_company"/>
                    </group>
                </search>
            </field>
        </record>

        <!-- Password Entry Action -->
        <record id="action_password_entry" model="ir.actions.act_window">
            <field name="name">Passwords</field>
            <field name="res_model">password.entry</field>
            <field name="view_mode">tree,form</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    No passwords found
                </p>
                <p>
                    Create your first password entry to get started.
                </p>
            </field>
        </record>
    </data>
</odoo> 