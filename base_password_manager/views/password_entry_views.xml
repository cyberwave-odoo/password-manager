<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Client Action for Copy to Clipboard -->
        <record id="action_copy_to_clipboard" model="ir.actions.client">
            <field name="name">Copy to Clipboard</field>
            <field name="tag">copy_to_clipboard</field>
        </record>

        <!-- Password Entry Form View -->
        <record id="view_password_entry_form" model="ir.ui.view">
            <field name="name">password.entry.form</field>
            <field name="model">password.entry</field>
            <field name="arch" type="xml">
                <form>
                    <header>
                        <button name="action_share_password" string="Share Password" type="object" class="btn-primary"/>
                    </header>
                    <sheet>
                        <div class="oe_title">
                            <h1>
                                <field name="name" placeholder="Title"/>
                            </h1>
                        </div>
                        <group>
                            <group >
                                <field name="username"  placeholder="jhon@example.com"/>
                                <field name="encrypted_password" widget="password_encryption" placeholder="e.g. my strong password"/>
                                <button name="%(base_password_manager.action_copy_to_clipboard)d" 
                                        string="Copy to Clipboard" 
                                        type="action" 
                                        class="btn btn-secondary"
                                        data-hotkey="c"/>
                                <field name="url"/>
                            </group>
                            <group>
                                <field name="company_id"/>
                                <field name="user_id"/>
                                <field name="write_date"/>
                            </group>
                        </group>
                        <notebook>
                            <page string="Access Information">
                                <group>
                                    <group string="Direct Access">
                                        <field name="share_ids" readonly="1"/>
                                    </group>
                                </group>
                            </page>
                            <page string="Notes">
                                <field name="notes"/>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- Password Entry List View -->
        <record id="view_password_entry_list" model="ir.ui.view">
            <field name="name">password.entry.list</field>
            <field name="model">password.entry</field>
            <field name="arch" type="xml">
                <list>
                    <field name="name"/>
                    <field name="username"/>
                    <field name="url"/>
                    <field name="write_date"/>
                    <button name="%(base_password_manager.action_copy_to_clipboard)d" 
                                        string="Copy to Clipboard" 
                                        type="action" 
                                        class="btn btn-primary"
                                        data-hotkey="c"/>
                </list>
            </field>
        </record>

        <!-- Password Entry Search View -->
        <record id="view_password_entry_search" model="ir.ui.view">
            <field name="name">password.entry.search</field>
            <field name="model">password.entry</field>
            <field name="arch" type="xml">
                <search>
                    <field name="name"/>
                    <field name="username"/>
                    <field name="url"/>
                    <filter string="My Passwords" name="my_passwords" domain="[('user_id', '=', uid)]"/>
                </search>
            </field>
        </record>

        <!-- Password Entry Action -->
        <record id="action_password_entry" model="ir.actions.act_window">
            <field name="name">Passwords</field>
            <field name="res_model">password.entry</field>
            <field name="view_mode">list,form</field>
            <field name="search_view_id" ref="view_password_entry_search"/>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Create your first password entry
                </p>
            </field>
        </record>

        <!-- Menu -->

    </data>
</odoo> 