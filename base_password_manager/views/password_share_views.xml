<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Form View -->
    <record id="view_password_share_form" model="ir.ui.view">
        <field name="name">password.share.form</field>
        <field name="model">password.share</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_revoke_access" 
                            string="Revoke Access" 
                            type="object" 
                            class="btn-primary"/>
                    <button name="action_save" 
                            string="Save" 
                            type="object" 
                            class="btn-primary"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="password_entry_id" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="shared_with_id"/>
                            <field name="access_type"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group>
                            <field name="expiry_date"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- List View -->
    <record id="view_password_share_list" model="ir.ui.view">
        <field name="name">password.share.list</field>
        <field name="model">password.share</field>
        <field name="arch" type="xml">
            <list create="false">
                <field name="password_entry_id"/>
                <field name="shared_with_id"/>
                <field name="access_type"/>
                <field name="expiry_date"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <!-- Search View -->
    <record id="view_password_share_search" model="ir.ui.view">
        <field name="name">password.share.search</field>
        <field name="model">password.share</field>
        <field name="arch" type="xml">
            <search>
                <field name="password_entry_id"/>
                <field name="shared_with_id"/>
                <separator/>

                <group expand="0" string="Group By">
                    <filter string="Password Entry" name="group_by_entry" context="{'group_by': 'password_entry_id'}"/>
                    <filter string="Shared With" name="group_by_user" context="{'group_by': 'shared_with_id'}"/>
                    <filter string="Access Type" name="group_by_access" context="{'group_by': 'access_type'}"/>
                    <filter string="Company" name="group_by_company" context="{'group_by': 'company_id'}" groups="base.group_multi_company"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Action -->
    <record id="action_password_share" model="ir.actions.act_window">
        <field name="name">Password Shares</field>
        <field name="res_model">password.share</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No password shares found
            </p>
            <p>
                Share passwords with other users and manage their access.
            </p>
        </field>
    </record>


    <!-- Menu Item -->

</odoo> 