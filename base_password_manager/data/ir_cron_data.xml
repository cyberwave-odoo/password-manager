<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="ir_cron_check_expired_shares" model="ir.cron">
            <field name="name">Password Manager: Check Expired Shares</field>
            <field name="model_id" ref="model_password_share"/>
            <field name="state">code</field>
            <field name="code">model._cron_check_expired_shares()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
            <field name="user_id" ref="base.user_root"/>
            <field name="nextcall" eval="(DateTime.now() + timedelta(days=1)).replace(hour=1, minute=0, second=0)"/>
        </record>
    </data>
</odoo> 