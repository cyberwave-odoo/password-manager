<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Password Entry Security Rules -->
    <record id="password_entry_comp_rule" model="ir.rule">
        <field name="name">Password Entry: Multi-Company Rule</field>
        <field name="model_id" ref="model_password_entry"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>

    <record id="password_entry_user_rule" model="ir.rule">
        <field name="name">Password Entry: User Access Rule</field>
        <field name="model_id" ref="model_password_entry"/>
        <field name="domain_force">[
            '|',
            ('user_id', '=', user.id),
            ('id', 'in', user.password_share_ids.mapped('password_entry_id').ids)
        ]</field>
    </record>

    <!-- Password Share Security Rules -->
    <record id="password_share_comp_rule" model="ir.rule">
        <field name="name">Password Share: Multi-Company Rule</field>
        <field name="model_id" ref="model_password_share"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>

    <record id="password_share_user_rule" model="ir.rule">
        <field name="name">Password Share: User Access Rule</field>
        <field name="model_id" ref="model_password_share"/>
        <field name="domain_force">[
            '|',
            ('password_entry_id.user_id', '=', user.id),
            ('shared_with_id', '=', user.id)
        ]</field>
    </record>

    <!-- Password Category Security Rules -->
    <record id="password_category_comp_rule" model="ir.rule">
        <field name="name">Password Category: Multi-Company Rule</field>
        <field name="model_id" ref="model_password_category"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>

    <record id="password_category_user_rule" model="ir.rule">
        <field name="name">Password Category: User Access Rule</field>
        <field name="model_id" ref="model_password_category"/>
        <field name="domain_force">[
            '|',
            ('user_id', '=', user.id),
            ('id', 'in', user.password_share_ids.mapped('password_entry_id.category_id').ids)
        ]</field>
    </record>
</odoo> 