<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Password Entry Security Rules -->
    <record id="password_entry_comp_rule" model="ir.rule">
        <field name="name">Password Entry: Multi-Company Rule</field>
        <field name="model_id" ref="model_password_entry"/>
        <field name="domain_force">[ ('company_id', 'in', company_ids)]</field>
    </record>

    <record id="password_entry_read_rule" model="ir.rule">
        <field name="name">Password Entry: Read Access Rule</field>
        <field name="model_id" ref="model_password_entry"/>
        <field name="domain_force">[
            '|',
            ('user_id', '=', user.id),
            ('id', 'in', user.password_share_ids.filtered(lambda s: s.access_type in ['read', 'write']).mapped('password_entry_id').ids)
        ]</field>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="password_entry_write_rule" model="ir.rule">
        <field name="name">Password Entry: Write Access Rule</field>
        <field name="model_id" ref="model_password_entry"/>
        <field name="domain_force">[
            '|',
            ('user_id', '=', user.id),
            ('id', 'in', user.password_share_ids.filtered(lambda s: s.access_type == 'write').mapped('password_entry_id').ids)
        ]</field>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>

    <!-- Password Share Security Rules -->
    <record id="password_share_comp_rule" model="ir.rule">
        <field name="name">Password Share: Multi-Company Rule</field>
        <field name="model_id" ref="model_password_share"/>
        <field name="domain_force">[ ('company_id', 'in', company_ids)]</field>
    </record>

    <record id="password_share_read_rule" model="ir.rule">
        <field name="name">Password Share: Read Access Rule</field>
        <field name="model_id" ref="model_password_share"/>
        <field name="domain_force">[
            '|',
            ('password_entry_id.user_id', '=', user.id),
            '|',
            ('shared_with_id', '=', user.id),
            ('password_entry_id', 'in', user.password_share_ids.filtered(lambda s: s.access_type == 'write').mapped('password_entry_id').ids)
        ]</field>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="password_share_write_rule" model="ir.rule">
        <field name="name">Password Share: Write Access Rule</field>
        <field name="model_id" ref="model_password_share"/>
        <field name="domain_force">[
            '|',
            ('password_entry_id.user_id', '=', user.id),
            '|',
            '&amp;',
            ('shared_with_id', '=', user.id),
            ('access_type', '=', 'write'),
            ('password_entry_id', 'in', user.password_share_ids.filtered(lambda s: s.access_type == 'write').mapped('password_entry_id').ids)
        ]</field>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>
</odoo> 