<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Password Entry Security Rules -->
    <record id="password_entry_comp_rule" model="ir.rule">
        <field name="name">Password Entry: Multi-Company Rule</field>
        <field name="model_id" ref="model_password_entry"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>


    <record id="password_entry_write_rule" model="ir.rule">
        <field name="name">Password Entry: Write Access Rule</field>
        <field name="model_id" ref="model_password_entry"/>
        <field name="domain_force">[('user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>
</odoo>
