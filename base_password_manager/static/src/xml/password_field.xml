<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="base_password_manager.EncryptedPasswordField" owl="1">
        <div class="o_field_password_encryption">
            <t t-if="props.readonly">
                <span t-esc="valueToDisplay"/>
            </t>
            <t t-else="">
                <input
                    class="o_input"
                    t-att-id="props.id"
                    type="password"
                    t-att-value="props.record.data[props.name]"

                    t-ref="input"
                />
            </t>
        </div>
    </t>



</templates>