<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="password_manager.PasswordEncryption" owl="1">
        <div class="password-encryption">
            <form t-on-submit.prevent="encryptPassword">
                <div class="form-group">
                    <label for="password">Password to Encrypt</label>
                    <input type="password" id="password" class="form-control" t-model="state.password"/>
                </div>
                <div class="form-group">
                    <label for="master-password">Master Password</label>
                    <input type="password" id="master-password" class="form-control" t-model="state.masterPassword"/>
                </div>
                <button type="submit" class="btn btn-primary">Encrypt</button>
            </form>

            <form t-on-submit.prevent="decryptPassword" class="mt-4">
                <div class="form-group">
                    <label for="encrypted-password">Encrypted Password</label>
                    <input type="text" id="encrypted-password" class="form-control" t-model="state.encryptedPassword"/>
                </div>
                <div class="form-group">
                    <label for="decrypt-master-password">Master Password</label>
                    <input type="password" id="decrypt-master-password" class="form-control" t-model="state.decryptMasterPassword"/>
                </div>
                <button type="submit" class="btn btn-primary">Decrypt</button>
            </form>

            <div t-if="state.encryptedResult" class="mt-4">
                <h4>Encrypted Result:</h4>
                <pre><t t-esc="state.encryptedResult"/></pre>
            </div>

            <div t-if="state.decryptedResult" class="mt-4">
                <h4>Decrypted Result:</h4>
                <pre><t t-esc="state.decryptedResult"/></pre>
            </div>
        </div>
    </t>
</templates> 