<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="password_manager.PasswordGenerator" owl="1">
        <div class="password-generator">
            <div class="form-group">
                <label for="password-length">Password Length</label>
                <input type="number" id="password-length" class="form-control" t-model="state.length" min="8" max="128"/>
            </div>

            <div class="form-group">
                <div class="custom-control custom-checkbox">
                    <input type="checkbox" id="include-uppercase" class="custom-control-input" t-model="state.includeUppercase"/>
                    <label class="custom-control-label" for="include-uppercase">Include Uppercase Letters</label>
                </div>
                <div class="custom-control custom-checkbox">
                    <input type="checkbox" id="include-lowercase" class="custom-control-input" t-model="state.includeLowercase"/>
                    <label class="custom-control-label" for="include-lowercase">Include Lowercase Letters</label>
                </div>
                <div class="custom-control custom-checkbox">
                    <input type="checkbox" id="include-numbers" class="custom-control-input" t-model="state.includeNumbers"/>
                    <label class="custom-control-label" for="include-numbers">Include Numbers</label>
                </div>
                <div class="custom-control custom-checkbox">
                    <input type="checkbox" id="include-special" class="custom-control-input" t-model="state.includeSpecial"/>
                    <label class="custom-control-label" for="include-special">Include Special Characters</label>
                </div>
            </div>

            <button t-on-click="generatePassword" class="btn btn-primary">Generate Password</button>

            <div t-if="state.generatedPassword" class="mt-4">
                <div class="form-group">
                    <label for="generated-password">Generated Password</label>
                    <div class="input-group">
                        <input type="text" id="generated-password" class="form-control" t-model="state.generatedPassword" readonly/>
                        <div class="input-group-append">
                            <button t-on-click="copyToClipboard" class="btn btn-outline-secondary" type="button">
                                <i class="fa fa-copy"/> Copy
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </t>
</templates> 