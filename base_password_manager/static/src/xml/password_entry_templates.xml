<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="base_password_manager.KeyUpdateDialog">
        <Dialog title="props.title" size="props.size">
            <div class="o_password_update_dialog">
                <p t-esc="props.message"/>
                <div class="form-group">
                    <label for="master_password">Master Password</label>
                    <input type="password" 
                           class="form-control" 
                           t-model="state.masterPassword"
                           placeholder="Enter your master password"/>
                </div>
                <div class="o_dialog_footer">
                    <button class="btn btn-secondary" t-on-click="() => this.props.close()">
                        Cancel
                    </button>
                    <button class="btn btn-primary" t-on-click="() => this.onUpdate()">
                        Update
                    </button>
                </div>
            </div>
        </Dialog>
    </t>
</templates> 