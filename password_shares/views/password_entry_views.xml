<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="view_password_entry_form_inherit" model="ir.ui.view">
            <field name="name">password.entry.form.inherit</field>
            <field name="model">password.entry</field>
            <field name="inherit_id" ref="base_password_manager.view_password_entry_form"/>
            <field name="arch" type="xml">
                <!-- Example: Add a field after username -->
                <xpath expr="//header[@name='Header']" position="inside">
                    <button name="action_share_password" string="Share Password" type="object" class="btn-primary"/>
                </xpath>

                <!-- Example: Modify button label -->
                <xpath expr="//page[@name='Notes']" position="before">
                    <page string="Access Information">
                        <group>
                            <group string="Direct Access">
                                <field name="share_ids" readonly="1"/>
                            </group>
                        </group>
                    </page>
                </xpath>
            </field>
        </record>

     
    </data>
</odoo> 